<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorldSimulation.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 第 02 章 b 節：正式設定（config/sheets 全部 CSV）與 TEMP 示範設定（config/demo）編入組件；
         CLI 與 Godot 由 OfficialConfig 共用同一份，Core 不讀磁碟。 -->
    <EmbeddedResource Include="../../config/sheets/*.csv" LogicalName="WorldSimulation.ConfigSheets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../config/demo/*" LogicalName="WorldSimulation.ConfigDemo/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
